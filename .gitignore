# ── secrets ───────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.xcconfig
# The template MUST be committed — it is what CI copies to build, and what a
# new clone copies to run. A blanket *.xcconfig swallowed it, which is why CI
# could not generate the project.
!ios/App/Config.example.xcconfig
Secrets.plist
supabase/.temp/
supabase/.branches/

# ── macOS / Xcode ─────────────────────────────────────────────────────────
.DS_Store
xcuserdata/
*.xcuserstate
DerivedData/
build/
*.ipa
*.dSYM.zip
.swiftpm/
Packages/

# ── node / deno (edge functions) ──────────────────────────────────────────
node_modules/
npm-debug.log*
deno.lock
!supabase/functions/deno.lock

# ── misc ──────────────────────────────────────────────────────────────────
*.log
.vscode/
.idea/

# ── Xcode project is generated from ios/project.yml ───────────────────────
ios/*.xcodeproj
ios/AlbusCore/.build/

# Real Supabase values — template is Config.example.xcconfig
ios/App/Config.xcconfig

# Fetched brand artwork. Not committed: the asset catalogue holds the same
# PNGs and is what the app builds from. `python3 scripts/tools/make_assets.py
# --restore` puts this directory back from the catalogue, no network needed.
scripts/tools/logos/
__pycache__/
